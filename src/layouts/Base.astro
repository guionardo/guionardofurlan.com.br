---
import '../styles/global.css';
import { languages, locale, prefix, routeGroups, languageFromPath, type Language } from '../lib/i18n';
interface Props { title: string; description?: string; translations?: Partial<Record<Language, string>> }
const lang = languageFromPath(Astro.url.pathname);
const copy = {
  pt: { description: 'Artigos, projetos e trajetória de Guionardo Furlan. Ideias, ferramentas e produtos.', nav: ['Início', 'Blog', 'Sobre & currículo', 'Projetos', 'Ferramentas'], skip: 'Pular para o conteúdo', navigation: 'Navegação principal', language: 'Idioma', blog: 'Blog de Guionardo Furlan', og: 'pt_BR', ogImageAlt: 'Site de Guionardo Furlan — artigos, projetos e ferramentas.' },
  en: { description: 'Articles, projects and background of Guionardo Furlan. Ideas, tools and products.', nav: ['Home', 'Blog', 'About & résumé', 'Projects', 'Tools'], skip: 'Skip to content', navigation: 'Main navigation', language: 'Language', blog: 'Guionardo Furlan’s blog', og: 'en_US', ogImageAlt: 'Guionardo Furlan’s website — articles, projects and tools.' },
  es: { description: 'Artículos, proyectos y trayectoria de Guionardo Furlan. Ideas, herramientas y productos.', nav: ['Inicio', 'Blog', 'Sobre mí & currículo', 'Proyectos', 'Herramientas'], skip: 'Saltar al contenido', navigation: 'Navegación principal', language: 'Idioma', blog: 'Blog de Guionardo Furlan', og: 'es_ES', ogImageAlt: 'Sitio web de Guionardo Furlan — artículos, proyectos y herramientas.' },
}[lang];
const translations = Astro.props.translations ?? routeGroups.find(group => group[lang] === Astro.url.pathname) ?? { [lang]: Astro.url.pathname };
const home = `${prefix(lang)}/`;
const feed = `${prefix(lang)}/rss.xml`;
const { title, description = copy.description } = Astro.props;
const links = [0, 1, 3, 2, 4].map(index => [routeGroups[index][lang], copy.nav[index]]);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={locale[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Guionardo Furlan</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.filter(language => translations[language]).map(language => <link rel="alternate" hreflang={locale[language]} href={new URL(translations[language]!, Astro.site)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={copy.blog} href={feed} />
    <meta property="og:title" content={`${title} · Guionardo Furlan`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={copy.og} />
    <meta property="og:site_name" content="Guionardo Furlan" />
    <meta property="og:image" content={new URL(`/images/og-default.${lang}.png`, Astro.site)} />
    <meta property="og:image:alt" content={copy.ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#conteudo">{copy.skip}</a>
    <header class="site-header wrap">
      <a class="brand" href={home} aria-label={`Guionardo Furlan, ${copy.nav[0]}`}>gf<span>.</span></a>
      <nav aria-label={copy.navigation}>
        {links.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href || (href !== home && Astro.url.pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="language-switch" role="group" aria-label={copy.language}>{languages.map(language => <a href={translations[language] ?? `${prefix(language)}/blog/`} lang={locale[language]} aria-current={lang === language ? 'true' : undefined}>{language.toUpperCase()}</a>)}</div>
    </header>
    <main id="conteudo" class="wrap"><slot /></main>
    <footer class="wrap"><span>© {new Date().getFullYear()} Guionardo Furlan</span><div class="footer-links"><a href="https://github.com/guionardo">GitHub ↗</a><a href="https://linkedin.com/in/guionardo">LinkedIn ↗</a><a href={feed}>RSS ↗</a></div></footer>
  </body>
</html>
