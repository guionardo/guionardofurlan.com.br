---
import { prefix, seriesCopy, type Language } from '../lib/i18n';
interface Props {
  series: { name: string; description: string };
  posts: { slug: string; title: string }[];
  currentSlug: string;
  lang: Language;
}
const { series, posts, currentSlug, lang } = Astro.props;
const index = posts.findIndex(p => p.slug === currentSlug);
const prev = index > 0 ? posts[index - 1] : null;
const next = index >= 0 && index < posts.length - 1 ? posts[index + 1] : null;
const copy = seriesCopy[lang];
---
<nav class="series-nav" aria-label={series.name}>
  <p class="series-eyebrow">{copy.series}</p>
  <h2>{series.name}</h2>
  <p class="series-description">{series.description}</p>
  <ol>
    {posts.map((post, i) => (
      <li class={post.slug === currentSlug ? 'current' : ''}>
        <span class="series-number">{i + 1}</span>
        {post.slug === currentSlug ? (
          <strong aria-current="page">{post.title}</strong>
        ) : (
          <a href={`${prefix(lang)}/blog/${post.slug}/`}>{post.title}</a>
        )}
      </li>
    ))}
  </ol>
  <div class="series-prevnext">
    {prev ? (
      <a href={`${prefix(lang)}/blog/${prev.slug}/`} rel="prev">← {copy.previous}</a>
    ) : (
      <span aria-hidden="true" />
    )}
    {next ? (
      <a href={`${prefix(lang)}/blog/${next.slug}/`} rel="next">{copy.next} →</a>
    ) : (
      <span aria-hidden="true" />
    )}
  </div>
</nav>

<style>
  .series-nav {
    margin-top: 48px;
    padding: 24px;
    border: 1px solid var(--line);
    border-left: 3px solid #aecb53;
  }
  .series-eyebrow {
    font-size: .8125rem;
    letter-spacing: .12em;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .series-nav h2 {
    font-size: 1.4rem;
    margin: 0 0 6px;
  }
  .series-description {
    margin: 0 0 16px;
  }
  .series-nav ol {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .series-nav li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: .9375rem;
    line-height: 1.5;
  }
  .series-number {
    font-size: .8125rem;
    font-weight: 700;
    color: var(--muted);
    min-width: 1.4em;
  }
  .series-nav li.current .series-number {
    color: var(--ink);
  }
  .series-nav a {
    color: inherit;
  }
  .series-prevnext {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    font-weight: 600;
  }
</style>