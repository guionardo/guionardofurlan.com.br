---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/content';
const posts = await getPosts();
---
<Base title="Blog"><section class="page-intro"><p class="eyebrow">IDEIAS POR ESCRITO</p><h1>Blog<span class="accent">.</span></h1><p>Aprendizados, reflexões e notas sobre desenvolvimento.</p></section>
{posts.length ? posts.map(post => <a class="post-row" href={`/blog/${post.data.slug}/`}><div><p class="eyebrow">{formatDate(post.data.date)}</p><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></div><span aria-hidden="true">↗</span></a>) : <div class="empty"><h2>Em breve, novos artigos.</h2><p>Você também pode acompanhar as próximas publicações pelo <a href="/rss.xml">feed RSS</a>.</p></div>}
</Base>
