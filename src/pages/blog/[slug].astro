---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, getTranslation } from '../../lib/content';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
const alternate = await getTranslation(post);
const { Content } = await render(post);
---
<Base alternate={alternate} title={post.data.title} description={post.data.description}>
  <article class="article"><a href="/blog/">← Voltar ao blog</a><header class="page-intro"><p class="eyebrow"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></header><div class="prose"><Content /></div></article>
</Base>
