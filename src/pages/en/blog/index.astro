---
import Base from '../../../layouts/Base.astro';
import { getPosts, formatDate } from '../../../lib/content';
const posts = await getPosts('en');
---
<Base title="Blog"><section class="page-intro"><p class="eyebrow">IDEAS IN WRITING</p><h1>Blog<span class="accent">.</span></h1><p>Lessons, reflections and notes on development.</p></section>
{posts.length ? posts.map(post => <a class="post-row" href={`/en/blog/${post.data.slug}/`}><div><p class="eyebrow">{formatDate(post.data.date, 'en')}</p><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></div><span aria-hidden="true">↗</span></a>) : <div class="empty"><h2>New articles coming soon.</h2><p>You can also follow upcoming articles through the <a href="/en/rss.xml">RSS feed</a>.</p></div>}
</Base>
