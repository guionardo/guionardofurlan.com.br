---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SeriesNav from '../../../components/SeriesNav.astro';
import { getPosts, formatDate, getTranslations, getSeriesEntry, getSeriesPosts } from '../../../lib/content';
export async function getStaticPaths() {
  return (await getPosts('es')).map(post => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
const translations = await getTranslations(post);
const { Content } = await render(post);
const seriesInfo = post.data.seriesKey
  ? { series: await getSeriesEntry(post.data.seriesKey, post.data.lang), posts: await getSeriesPosts(post.data.seriesKey, post.data.lang) }
  : null;
---
<Base translations={translations} title={post.data.title} description={post.data.description}>
  <article class="article"><a href="/es/blog/">← Volver al blog</a><header class="page-intro"><p class="eyebrow"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'es')}</time></p><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></header><div class="prose"><Content /></div>
  {seriesInfo?.series ? <SeriesNav series={seriesInfo.series.data} posts={seriesInfo.posts.map(p => ({ slug: p.data.slug, title: p.data.title }))} currentSlug={post.data.slug} lang={post.data.lang} /> : null}
  </article>
</Base>
